.env
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.claude/settings.local.json

# Personal career data for the command-line workflow: never commit. Created on first run.
/workspace/
# Folder names used before the workspace/ layout; still ignored for older checkouts.
/resume_input/
/resume_create/
/resume_archive/

# Resume Taylor (browser app): per-project data and local state. Never commit.
/projects/
/demo_workspace/
/app_settings.json
.taylor_port
.taylor_tmp/
/.venv/
frontend/node_modules/
# frontend/dist/ IS committed: it is the prebuilt web app, so users need no Node.js.
frontend/openapi.json
frontend/.build-hash

# Personal never-claim list (a starter is tracked as do_not_claim.example.txt)
/do_not_claim.txt
/secrets.json

# Safety net: no resumes or PDFs get committed by accident. Sample files that
# are meant to ship live in examples/ and docs/ and are allowed below.
*.docx
*.pdf
!examples/**/*.docx
!examples/*.docx
!docs/**
!.env.example
